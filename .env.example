# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Google Maps
GOOGLE_MAPS_API_KEY_ANDROID=your_android_key
GOOGLE_MAPS_API_KEY_IOS=your_ios_key
GOOGLE_MAPS_API_KEY_WEB=your_web_key

# Firebase
FIREBASE_PROJECT_ID=your_project_id
# (other values come from google-services.json / GoogleService-Info.plist)

# SMS - Africa's Talking
SMS_PROVIDER=africastalking
SMS_AT_USERNAME=your_username
SMS_API_KEY=your_at_api_key
SMS_SENDER_ID=Wedit

# AWS S3 Backup
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=wedit-backup
AWS_REGION=us-east-1

# Payment
CHAPA_SECRET_KEY=your_chapa_key
TELEBIRR_APP_KEY=your_telebirr_key
TELEBIRR_APP_SECRET=your_telebirr_secret
TELEBIRR_SHORT_CODE=your_short_code
