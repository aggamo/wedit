# Supabase (anon key is safe to hardcode but listed here for reference)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Google Maps (REQUIRED before release — replace in app_constants.dart)
GOOGLE_MAPS_API_KEY_ANDROID=AIza...
GOOGLE_MAPS_API_KEY_IOS=AIza...
GOOGLE_MAPS_API_KEY_WEB=AIza...

# Firebase (run: flutterfire configure — generates firebase_options.dart automatically)
# Do NOT commit firebase_options.dart — it is in .gitignore
FIREBASE_PROJECT_ID=your_project_id

# SMS — Africa's Talking (primary provider)
SMS_PROVIDER=africastalking
SMS_AT_USERNAME=your_at_username
SMS_API_KEY=your_at_api_key
SMS_SENDER_ID=Wedit

# SMS — Generic JSON gateway (alternative, set SMS_PROVIDER=generic)
# SMS_GATEWAY_URL=https://your-sms-gateway.com/send

# AWS S3 Backup
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=wedit-backup
AWS_REGION=us-east-1

# Payments — Chapa
CHAPA_PUBLIC_KEY=CHAPUBK-...
CHAPA_SECRET_KEY=CHASECK-...

# Payments — Telebirr
TELEBIRR_APP_ID=your_app_id
TELEBIRR_APP_KEY=your_app_key
TELEBIRR_APP_SECRET=your_app_secret
TELEBIRR_MERCHANT_CODE=your_merchant_code
TELEBIRR_SHORT_CODE=your_short_code

# Payment webhook secrets (used to verify incoming webhooks from Chapa/Telebirr)
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
TELEBIRR_WEBHOOK_SECRET=your_telebirr_webhook_secret
# Set to 'true' only in dev/staging to skip Telebirr signature verification
TELEBIRR_SKIP_SIG_VERIFY=false

# Firebase Cloud Messaging — required for push notifications (send-notification function)
FCM_PROJECT_ID=your_firebase_project_id
# Full service account JSON (single-line escaped) from Firebase Console → Project Settings → Service accounts
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Dialogflow / AI voice sessions (handle-voice-session function)
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id
DIALOGFLOW_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_API_KEY=your_google_api_key
AI_CALL_WEBHOOK_SECRET=your_ai_call_webhook_secret

# Deep link base URL (used by auto-renew-subscription for payment redirect)
APP_DEEP_LINK_URL=https://your-app.page.link
